<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/main_frame"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="?attr/modernPrefPanelBackground"
              tools:ignore="Overdraw"
              android:elevation="@dimen/lb_preference_decor_elevation"
              android:orientation="vertical"
              android:transitionGroup="false"
>

    <FrameLayout
        android:id="@+id/decor_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/modernPrefTitleBackground"
        android:elevation="@dimen/lb_preference_decor_title_container_elevation"
        android:transitionGroup="false"
        tools:ignore="UselessParent"
        >
        <!-- In a FrameLayout: the transparent chat hides the title by it (see ViewUtil.enableTransparentDialog) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <!-- Change TextView to TitleMarqueeTextViewCompat if you need scrolled header in dialogs -->
            <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.TitleMarqueeTextViewCompat
                android:id="@+id/decor_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lb_preference_decor_title_text_height"
                android:layout_marginTop="@dimen/lb_preference_decor_title_margin_top"
                android:layout_marginStart="@dimen/lb_preference_decor_title_margin_start"
                android:layout_marginEnd="@dimen/lb_preference_decor_title_margin_end"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:textSize="@dimen/lb_preference_decor_title_text_size"
                android:textColor="?android:attr/textColorPrimary"

                android:singleLine="false"
                android:maxLines="2"
                android:ellipsize="end"
                />

            <!-- The comments panel's number of comments (see CommentsPreferenceDialogFragment), none in the chat's -->
            <TextView
                android:id="@+id/decor_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lb_preference_decor_title_margin_start"
                android:layout_marginEnd="@dimen/lb_preference_decor_title_margin_end"
                android:layout_marginBottom="@dimen/lb_preference_decor_title_margin_bottom"
                android:fontFamily="sans-serif"
                android:textSize="@dimen/decor_subtitle_text_size"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone"
                />
        </LinearLayout>
    </FrameLayout>

    <!--<TextView-->
    <!--    android:id="@android:id/message"-->
    <!--    android:layout_width="match_parent"-->
    <!--    android:layout_height="wrap_content"-->
    <!--    android:fontFamily="sans-serif-condensed"-->
    <!--    android:paddingTop="14dp"-->
    <!--    android:paddingBottom="14dp"-->
    <!--    android:paddingStart="24dp"-->
    <!--    android:paddingEnd="56dp"-->
    <!--    android:visibility="gone" />-->

    <com.stfalcon.chatkit.messages.MessagesList
        android:id="@+id/messagesList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:textAutoLink="web"
        app:showIncomingTime="false"
        app:isMessageFocusable="true"
        app:incomingBubblePaddingLeft="10sp"
        app:incomingBubblePaddingRight="10sp"
        app:incomingBubblePaddingTop="0sp"
        app:incomingBubblePaddingBottom="0sp"
        app:incomingAvatarWidth="30dp"
        app:incomingAvatarHeight="30dp"
        app:incomingDefaultBubbleColor="?attr/modernPrefChatBubble"
        app:incomingDefaultBubbleSelectedColor="?attr/modernPrefChatBubbleFocused"
        app:incomingDefaultBubblePressedColor="?attr/modernPrefChatBubbleFocused"
        app:incomingTextColor="@color/white"
        />

</LinearLayout>
